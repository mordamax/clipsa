{
  "name": "clipsa",
  "private": true,
  "description": "Clipsa — a private, encrypted clipboard history manager for macOS, Windows and Linux.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "tauri": "tauri",
    "install:mac": "scripts/install-macos.sh",
    "site": "node scripts/build-site.mjs",
    "stats": "node scripts/download-stats.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.17"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "covector": "0.13.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "wrangler": "4.164.0"
  }
}
