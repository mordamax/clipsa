{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipsa",
  "version": "0.1.0",
  "identifier": "com.clipsa.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build",
    "features": ["self-update"]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clipsa",
        "url": "/",
        "width": 900,
        "height": 640,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "picker",
        "title": "Clipsa Quick Picker",
        "url": "/picker",
        "width": 760,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      },
      {
        "label": "updater",
        "title": "Software Update",
        "url": "/updater",
        "width": 560,
        "height": 420,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDMUY0RDdDNEQyMDM3RkYKUldUL055Qk5mRTBmSEJCekxjNVVjcmJnWEx5VGdVSVNibGExT0RlclA3LzJ4blJJSEMvZkVaOVgK",
      "endpoints": [
        "https://github.com/mordamax/clipsa/releases/latest/download/latest.json"
      ]
    }
  }
}
